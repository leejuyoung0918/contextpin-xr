# Load these in the terminal that starts server.py. Never put keys in Unity assets.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Select models supported by your provider (vision + guide JSON / audio transcription).
AI_VISION_MODEL=
AI_TRANSCRIPTION_MODEL=
RELAY_PORT=8787
# Optional local storage directory. The default is artifacts/relay-sessions.
# RELAY_DATA_DIR=
