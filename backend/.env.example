# Settings for the PC meeting server (scripts/relay.py server).
# OPENSCAD_EXECUTABLE=/path/to/openscad
# EDGE_ADVERTISED_URL=http://192.168.1.100:8789
# Local transcription and registered legacy design plans.
MEETING_STT_BACKEND=local
MEETING_PLAN_BACKEND=registered

# Default CAD candidate model. Loopback overrides are also supported for QA.
MEETING_BUNDLE_BASE_URL=http://127.0.0.1:18905/v1
MEETING_BUNDLE_MODEL=qwen3-vl-2b

# Meeting PC inference uses the local models even if cloud keys exist in the shell.
